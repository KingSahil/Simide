{
  "name": "simide-ide",
  "displayName": "SimIDE - DSA Visualizer",
  "description": "SimIDE (Simulation + IDE) — Interactive DSA Simulation & Real-time C++ Debugging in VS Code",
  "version": "0.1.0",
  "publisher": "kingsahil",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/KingSahil/Simide"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Education"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:cpp"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "debug-mentor-view-container",
          "title": "SimIDE",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "debug-mentor-view-container": [
        {
          "type": "webview",
          "id": "debug-mentor.sidebar",
          "name": "SimIDE",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "debug-mentor.visualize",
        "title": "SimIDE: Visualize C++ Execution",
        "category": "SimIDE",
        "icon": "$(play)"
      },
      {
        "command": "debug-mentor.next",
        "title": "SimIDE: Next Step",
        "category": "SimIDE",
        "icon": "$(arrow-right)"
      },
      {
        "command": "debug-mentor.prev",
        "title": "SimIDE: Previous Step",
        "category": "SimIDE",
        "icon": "$(arrow-left)"
      },
      {
        "command": "debug-mentor.restart",
        "title": "SimIDE: Restart Session",
        "category": "SimIDE",
        "icon": "$(debug-restart)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "node test/runAll.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/d3-force": "^3.0.10",
    "d3-force": "^3.0.0"
  }
}
